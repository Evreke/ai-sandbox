{
  "name": "@evreke/pi-grill-deck",
  "version": "1.4.1",
  "description": "Interactive question deck for pi — grill the user round by round: all questions of a frontier in one TUI, recommendation fast-accept, defer, structured answers back to the model.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "grilling",
    "interview",
    "requirements"
  ],
  "license": "MIT",
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "index.ts",
    "lib.ts",
    "onboarding.md",
    "README.md",
    "ATTRIBUTION.md",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.84.4",
    "vitest": "^4.1.11"
  }
}
